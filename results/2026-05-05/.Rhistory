library(DESeq2)
.libPaths("./R")
counts <- as.matrix(genex[ , -c(1,2)])
row.names(counts) <- genex$gene_id
dds1 <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = muestras,
  design = ~ population + temp
)
counts <- as.matrix(genex[ , -c(1,2)])
row.names(counts) <- genex$gene_id

counts <- round(counts)
dds1 <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = muestras,
  design = ~ population + temp
)
dds1 <- DESeq(dds1)
res <- results(dds1)
plotMA(res)
plotMA(res)
resShrink <- lfcShrink(dds1, coef = 'temp_high_vs_low',
                       type = 'normal')
plotMA(resShrink)
resultsNames(dds1)
resShrink <- lfcShrink(dds1, coef = 'temp_low_vs_high',
                       type = 'normal')
resShrink <- lfcShrink(dds1, coef = "temp_high_vs_low", type = "normal")
plot(resShrink$log2FoldChange,
     -log10(resShrink$padj),
     pch = 20,
     xlab = "log2 Fold Change",
     ylab = "-log10 adjusted p-value",
     main = "Volcano plot")
sig <- resShrink$padj < 0.05

plot(resShrink$log2FoldChange,
     -log10(resShrink$padj),
     pch = 20,
     col = ifelse(sig, "red", "black"),
     xlab = "log2 Fold Change",
     ylab = "-log10 adjusted p-value",
     main = "Volcano plot")

abline(h = -log10(0.05), col = "blue", lty = 2)
abline(v = c(-1, 1), col = "grey", lty = 2)
dds2 <- vst(dds1)
NormCounts <- assay(dds2)
res <- res[! is.na(res$pvalue), ]
res <- res[order(res$log2FoldChange),]
heatmap(NormCounts[c(head(row.names(res), 100),
                     tail(row.names(res), 100)), ],
        Rowv = NA, Colv = NA)
res <- results(dds1, contrast = c("temp", "high", "low"))
log2FoldChange = high / low
sum(res$log2FoldChange > 0, na.rm = TRUE)
sum(res$log2FoldChange < 0, na.rm = TRUE)
